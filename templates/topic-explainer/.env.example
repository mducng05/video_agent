# ==============================================================================
# CẤU HÌNH GIỌNG ĐỌC EDGE TTS (edge-tts-universal) - PWSOLUTIONS
# ==============================================================================

# Giọng đọc mặc định: vi-VN-NamMinhNeural (Nam - Trầm ấm, dứt khoát, chuyên nghiệp B2B)
EDGE_TTS_VOICE=vi-VN-NamMinhNeural

# Tốc độ đọc (Rate): +10%
EDGE_TTS_RATE=+10%
EDGE_TTS_PITCH=+0Hz
EDGE_TTS_VOLUME=+0%

# Thư mục xuất file audio (mặc định: public/audio)
EDGE_TTS_OUTPUT_DIR=public/audio

# ==============================================================================
# THƯƠNG HIỆU DOANH NGHIỆP (BRANDING)
# ==============================================================================
CHANNEL_NAME="PWSolutions"
BRAND_NAME="PWS Việt Nam"
WEBSITE="https://pwsdata.vn"
FACEBOOK="https://www.facebook.com/pwsvn"
