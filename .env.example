# ==============================================================================
# BỘ CẤU HÌNH BIẾN MÔI TRƯỜNG DÙNG CHUNG - AI VIDEO STUDIO (3 TEMPLATES)
# ==============================================================================
# Sao chép file này thành .env ở thư mục gốc:
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. THƯƠNG HIỆU KÊNH (BRANDING DÙNG CHUNG)
# ------------------------------------------------------------------------------
CHANNEL_NAME="CƯỜNG IT"
CHANNEL="CƯỜNG IT"

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH TTS MẶC ĐỊNH (EDGE TTS - 100% MIỄN PHÍ, KHÔNG CẦN API KEY)
# Dùng chung được cho cả 3 Template: Topic Explainer, News Video, Compare Video
# ------------------------------------------------------------------------------
# Provider mặc định: "edge-tts" (hoặc "edge")
TTS_PROVIDER=edge-tts

# Danh sách giọng tiếng Việt:
# - vi-VN-NamMinhNeural (Nam - trầm ấm, rõ ràng, phù hợp so sánh & tin tức)
# - vi-VN-HoaiMyNeural  (Nữ - truyền cảm, tự nhiên)
EDGE_TTS_VOICE=vi-VN-NamMinhNeural
EDGE_VOICE=vi-VN-NamMinhNeural

# Tốc độ đọc: +0%, +10%, +15% (video ngắn nên để +10% hoặc +15% để cuốn hút)
EDGE_TTS_RATE=+10%
EDGE_TTS_PITCH=+0Hz
EDGE_TTS_VOLUME=+0%

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH DÀNH RIÊNG CHO TEMPLATE 1: TOPIC EXPLAINER (REMOTION)
# ------------------------------------------------------------------------------
EDGE_TTS_OUTPUT_DIR=public/audio

# ------------------------------------------------------------------------------
# 4. CẤU HÌNH DÀNH RIÊNG CHO TEMPLATE 2: NEWS FROM URL/TXT (HYPERFRAMES)
# Hỗ trợ thêm các nhà cung cấp TTS khác ngoài Edge TTS nếu có tài khoản:
# ------------------------------------------------------------------------------
# [Tùy chọn] Theme video: dark-neon (mặc định) | light-pro
VIDEO_THEME=dark-neon

# [Tùy chọn] Thẻ Outro Follow TikTok cuối video
TIKTOK_DISPLAY_NAME="Cường IT"
TIKTOK_HANDLE="@cuongit96"
TIKTOK_FOLLOWERS="50K"

# [Tùy chọn] LucyLab.io (TTS Clone giọng Việt + hỗ trợ SRT) - Nếu dùng đổi TTS_PROVIDER=lucylab
VIETNAMESE_API_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
VIETNAMESE_VOICEID=22charvoiceiduuidhere
LUCYLAB_ENDPOINT=https://api.lucylab.io/json-rpc

# [Tùy chọn] ElevenLabs (Đa ngôn ngữ cao cấp) - Nếu dùng đổi TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_ENDPOINT=https://api.elevenlabs.io/v1

# [Tùy chọn] Vbee TTS (Giọng chuẩn đài truyền hình) - Nếu dùng đổi TTS_PROVIDER=vbee
VBEE_APP_ID=your_vbee_app_id
VBEE_ACCESS_TOKEN=your_vbee_access_token
VBEE_VOICE_CODE=n_hanoi_male_protrainer_education_vc
VBEE_ENDPOINT=https://vbee.vn/api/v1/tts

# ------------------------------------------------------------------------------
# 5. CẤU HÌNH DÀNH RIÊNG CHO TEMPLATE 3: COMPARE CONCEPTS (HYPERFRAMES 3-ZONE)
# ------------------------------------------------------------------------------
# 0 = Agent dừng lại xác nhận kịch bản trước khi render | 1 = Chạy tự động hoàn toàn
AUTO_CREATE_VIDEO=0

# [Tùy chọn] VieNeu TTS (Chạy local siêu tốc qua CIT Voice Studio) - Nếu dùng đổi TTS_PROVIDER=vieneu
VIENEU_API_URL=http://127.0.0.1:8001
VIENEU_VOICE=Minh Đức
VIENEU_SPEED=1.0
